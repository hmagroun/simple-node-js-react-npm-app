pipeline {
    agent {
        docker {
            image 'node:lts-alpine'
            // On mappe le port 3000 pour l'accès web
            // On mappe un dossier de l'hôte vers le cache npm du conteneur
            //args '-p 3000:3000 -u root:root -v $HOME/.npm:/root/.npm'
            args '-p 3000:3000 -v $HOME/.npm:/root/.npm'
        }
    }
    environment {
        CI = 'true'
        // On force npm à utiliser le dossier monté pour le cache
        npm_config_cache = '/root/.npm'
    }
    stages {
        stage('Install') {
            steps {
                // Utiliser 'npm ci' au lieu de 'npm install' pour les environnements CI
                // C'est plus rapide et plus fiable (basé sur package-lock.json)
                sh 'npm ci'
            }
        }
        stage('Test') {
            steps {
                sh './jenkins/scripts/test.sh'
            }
        }
        stage('Deliver') {
            steps {
                withEnv(['BUILD_ID=dontKillMe']) {
                    sh './jenkins/scripts/deliver.sh'
                }
                input message: 'Application prête. Arrêter le serveur ?'
                sh './jenkins/scripts/kill.sh'
            }
        }
    }
}
